MMORPG_ZONE_IDS=1
MMORPG_BIND_IP=127.0.0.1
MMORPG_PORT=4433
MMORPG_STATUS_PORT=8080
MMORPG_CERT_PEM=cert.pem
MMORPG_KEY_PEM=key.pem
MMORPG_RECOVERY_DIR=recovery/zone-host
MMORPG_ROUTE_PREFIX=/game
MMORPG_RECONNECT_GRACE_TICKS=600
MMORPG_DRAIN_GRACE_MS=500
# PostgreSQL builds (docs/NATIVE_CLIENT.md#postgresql-migration-and-tls): migrate first with a
# login allowed to change schemas, then serve with one that is not. sslmode=require/verify-full
# selects verified TLS; sslrootcert adds a CA file to the system roots.
# MMORPG_PERSISTENCE_MODE=migrate
# MMORPG_MIGRATION_DATABASE_URL=postgres://migrator:…@db:5432/mmorpg?sslmode=verify-full
# MMORPG_HANDOFF_DATABASE_URL=postgres://handoff:…@db:5432/mmorpg?sslmode=verify-full&sslrootcert=/etc/mmorpg/db-ca.pem
