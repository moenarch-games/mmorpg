{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>moritzbrantner/coding-agent-conventions"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "physics-engine is pinned by commit; follow its main promptly so the physics A/B test checks every engine change",
      "matchPackageNames": ["physics-engine"],
      "groupName": "physics-engine",
      "schedule": ["at any time"],
      "automerge": true
    }
  ]
}
