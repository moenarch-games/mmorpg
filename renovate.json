{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>moritzbrantner/coding-agent-conventions"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "physics-engine moves in its own PR, so a failure in another digest update cannot hold it back, or the reverse.",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "physics-engine"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "physics-engine"
    }
  ]
}
